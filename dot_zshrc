# Interactive shell configuration is split into small, ordered modules.
[[ -o interactive ]] || return

typeset -g ZSH_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

source "$ZSH_CONFIG_HOME/common.zsh"

case "$OSTYPE" in
  darwin*) source "$ZSH_CONFIG_HOME/macos.zsh" ;;
  linux*)  source "$ZSH_CONFIG_HOME/linux.zsh" ;;
esac

[[ -r "$ZSH_CONFIG_HOME/local.zsh" ]] && source "$ZSH_CONFIG_HOME/local.zsh"

source "$ZSH_CONFIG_HOME/proxy.zsh"
source "$ZSH_CONFIG_HOME/conda.zsh"
source "$ZSH_CONFIG_HOME/tools.zsh"
source "$ZSH_CONFIG_HOME/plugins.zsh"

unset ZSH_CONFIG_HOME
